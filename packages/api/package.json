{
  "name": "@generatenu/api",
  "version": "0.1.0",
  "description": "Generated typed client (React Query + fetch) for the Generate admin API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenerateNU/admin.git",
    "directory": "packages/api"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "orval --config ./orval.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19"
  },
  "devDependencies": {
    "orval": "^7",
    "typescript": "^5"
  }
}
