# All NEXT_PUBLIC_* values are baked into the browser bundle. That is fine here:
# client id, tenant id and scope are public identifiers, and the SPA uses PKCE, no secret.
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_API_SCOPE=api://<api-client-id>/access_as_user
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
